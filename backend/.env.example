# KaryaDesk Backend Configuration
# Port is automatically assigned by Render (default: 5000 for local development)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# CORS allowed origins ('*' or specific frontend URL e.g. https://karyadesk.pages.dev)
CORS_ORIGIN=*

# Path to SQLite database (defaults to data/karyadesk.db, or ':memory:' for transient)
DB_PATH=./data/karyadesk.db
